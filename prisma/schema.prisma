datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Chambres d'hôtes ──
model Room {
  id                String     @id @default(cuid())
  name              String
  nameEn            String     @default("")
  slug              String     @unique
  subtitle          String     @default("")
  subtitleEn        String     @default("")
  description       String     @default("")
  descriptionEn     String     @default("")
  longDescription   String     @default("")
  longDescriptionEn String     @default("")
  color             String     @default("") // oklch accent, per-room theming
  price             Float      @default(0)  // "from" price, EUR
  currency          String     @default("EUR")
  size              String     @default("") // e.g. "30 m²"
  bedType           String     @default("")
  bedTypeEn         String     @default("")
  maxGuests         Int        @default(2)
  image             String     @default("")
  images            String     @default("") // comma-separated URLs
  amenities         String     @default("") // comma-separated (FR)
  amenitiesEn       String     @default("")
  highlights        String     @default("")
  highlightsEn      String     @default("")
  // Client brief (Nov 2026): space within the estate, "Idéale pour", per-suite SEO
  space             String     @default("") // riad | pavillon | independant
  idealFor          String     @default("")
  idealForEn        String     @default("")
  metaTitle         String     @default("")
  metaTitleEn       String     @default("")
  metaDescription   String     @default("")
  metaDescriptionEn String     @default("")
  featured          Boolean    @default(false)
  order             Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  rates             RoomRate[]
  bookings          Booking[]
}

// ── Tarification par saison ──
model RoomRate {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label     String   // e.g. "Haute saison"
  labelEn   String   @default("")
  startDate DateTime
  endDate   DateTime
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Expériences / SPA / Loisirs ──
model Experience {
  id            String   @id @default(cuid())
  title         String
  titleEn       String   @default("")
  slug          String   @unique
  subtitle      String   @default("")
  subtitleEn    String   @default("")
  description   String   @default("")
  descriptionEn String   @default("")
  category      String   @default("wellness") // wellness | outdoor | leisure | dining
  duration      String   @default("")
  price         Float    @default(0)
  image         String   @default("")
  icon          String   @default("")
  featured      Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Témoignages ──
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String   @default("")
  quote     String
  quoteEn   String   @default("")
  rating    Int      @default(5)
  date      String   @default("")
  source    String   @default("website") // website | google | booking | airbnb
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ── Blog ──
model BlogPost {
  id        String   @id @default(cuid())
  title     String
  titleEn   String   @default("")
  slug      String   @unique
  excerpt   String   @default("")
  excerptEn String   @default("")
  content   String   @default("") // HTML
  contentEn String   @default("")
  category  String   @default("")
  author    String   @default("Villa Serena")
  readTime  Int      @default(5)
  metaTitle         String @default("")
  metaTitleEn       String @default("")
  metaDescription   String @default("")
  metaDescriptionEn String @default("")
  imageAlt          String @default("")
  imageAltEn        String @default("")
  image     String   @default("")
  tags      String   @default("") // comma-separated
  published Boolean  @default(false)
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Galerie ──
model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  altEn     String   @default("")
  caption   String   @default("")
  captionEn String   @default("")
  category  String   @default("garden") // rooms | garden | dining | wellness
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Réservations / Demandes de devis ──
model Booking {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String    @default("")
  serviceType String    @default("room") // room | privatisation | retreat | seminar
  roomId      String?
  room        Room?     @relation(fields: [roomId], references: [id])
  checkIn     DateTime?
  checkOut    DateTime?
  guests      Int       @default(2)
  message     String    @default("")
  locale      String    @default("fr") // language of the guest, for the automatic emails
  // pending (request) → confirmed (by the villa, deposit link sent) → deposit_paid → paid (balance) → completed;
  // or cancelled / expired (deposit not paid within 72 h). See lib/booking-status.ts.
  status      String    @default("pending")
  // Acceptance of the terms of sale + house rules (Avenant 1, M48): when and which version.
  termsAcceptedAt DateTime?
  termsVersion    String    @default("")
  totalAmount Float     @default(0) // agreed price of the stay, EUR incl. VAT (tourist tax apart)
  currency    String    @default("EUR")
  depositAmount Float   @default(0) // 50 % (or 100 % when booked less than 30 days ahead)
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  cancelledBy   String    @default("") // client | villa
  cancelReason  String    @default("")
  // Automatic steps already done (so the daily job never repeats them).
  balanceLinkSentAt  DateTime?
  balanceReminderAt  DateTime?
  balanceAlertAt     DateTime?
  arrivalReminderAt  DateTime?
  payments    Payment[]
  events      BookingEvent[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Messages de contact ──
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Admin ──
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hash
  name      String   @default("")
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Journal des connexions à l'administration ──
model LoginLog {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String   @default("")
  country   String   @default("")
  city      String   @default("")
  device    String   @default("") // Ordinateur | Mobile | Tablette
  browser   String   @default("")
  os        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Photos du site (replaceable from the admin; the code holds the defaults) ──
/// One money movement for a booking: deposit, balance, refund, card hold for the 1 500 € deposit.
model Payment {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind        String    // deposit | balance | full | refund | caution
  method      String    @default("") // paypal | cmi | transfer | cash | other
  amount      Float
  currency    String    @default("EUR")
  // pending → paid | failed | expired | cancelled ; refund: refunded ; caution: authorized → released | captured
  status      String    @default("pending")
  token       String?   @unique // secret part of the payment link sent to the guest
  expiresAt   DateTime?
  paidAt      DateTime?
  provider    String    @default("")
  providerRef String    @default("") // order / transaction id at PayPal or the CMI
  note        String    @default("")
  termsAcceptedAt DateTime? // terms accepted again on the payment page, before paying
  termsVersion    String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([bookingId])
  @@index([status, expiresAt])
}

/// Timeline of a booking: emails sent, payments, status changes (shown in the admin).
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String
  message   String   @default("")
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

/// Simple key/value settings edited in the admin (bank details for transfers…).
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model SiteImage {
  key       String   @id // slot, e.g. "home.hero"
  url       String
  alt       String   @default("")
  altEn     String   @default("")
  updatedAt DateTime @updatedAt
}
